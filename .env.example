# ---- Server (set in Vercel → Project → Settings → Environment Variables) ----
# Neon Postgres connection string (pooled). Tables are created automatically.
DATABASE_URL=
# Random 32+ character string used to sign login sessions: `openssl rand -hex 32`
SESSION_SECRET=
# Comma-separated wallet addresses allowed into /admin pages.
ADMIN_WALLETS=
# Helius mainnet RPC URL. Without it the app falls back to Solana's public RPC (rate limited).
HELIUS_RPC_URL=
# Pinata JWT for token image + metadata uploads on the launch page.
PINATA_JWT=
# Jupiter API key for market data and swaps (optional; public limits apply without it).
JUP_API_KEY=
# Optional: GitHub token + repo for the Releases page (admin only).
GITHUB_TOKEN=
GH_REPO=Novalite999/kydos
# Optional: lets Vercel Cron call admin-only jobs.
CRON_SECRET=

# ---- Browser (public, baked in at build time) ----
# DBC launches stay disabled until a verified release manifest is supplied. See docs/dbc-mainnet.md.
VITE_KYDOS_DBC_RELEASE='{"enabled":false,"genesisHash":"5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d","config":"","programDataHashes":{}}'

# ---- Local only ----
# `PGLITE=1 npm run dev:api` runs the API against an in-memory Postgres instead of Neon.
